#!/usr/bin/bash
echo "🔐 ENCRYPTION-IN-BUCKET"

set -e  # Stop script on first failure

# Check if bucket name is provided
if [ -z "$1" ]; then
    echo "❌ Error: Bucket name is required."
    exit 1
fi

# Check if file name is provided
if [ -z "$2" ]; then
    echo "❌ Error: File name is required."
    exit 1
fi

bucket_name="$1"
file_name="$2"
kms_key_id="${3:-}"  # Optional KMS Key ID

# Check if the bucket exists
bucket_exists=$(aws s3api list-buckets --query "Buckets[?Name=='$bucket_name'].Name" --output text)

if [ "$bucket_exists" != "$bucket_name" ]; then
    echo "❌ Error: Bucket '$bucket_name' does not exist!"
    exit 1
fi

# Enable versioning for the bucket
aws s3api put-bucket-versioning --bucket "$bucket_name" --versioning-configuration Status=Enabled

if [ -f "$file_name" ]; then
    echo "📂 Creating encryption folders in S3..."
    
    # Create "folders" (empty objects with "/")
    aws s3api put-object --bucket "$bucket_name" --key "put_objects-SSE-S3/"
    aws s3api put-object --bucket "$bucket_name" --key "put_objects-SSE-KMS/"
    aws s3api put-object --bucket "$bucket_name" --key "put_objects-SSE-C/"

    echo "🚀 Uploading and encrypting files..."

    # SSE-S3 (Managed by AWS)
    aws s3api put-object --bucket "$bucket_name" --key "put_objects-SSE-S3/$file_name" --body "$file_name" --server-side-encryption AES256
    echo "✅ Uploaded with SSE-S3 (AES256) → $bucket_name/put_objects-SSE-S3/$file_name"

    # SSE-KMS (Customer Managed Key)
    if [ -n "$kms_key_id" ]; then
        aws s3api put-object --bucket "$bucket_name" --key "put_objects-SSE-KMS/$file_name" --body "$file_name" --server-side-encryption aws:kms --ssekms-key-id "$kms_key_id"
        echo "✅ Uploaded with SSE-KMS (KMS Key ID: $kms_key_id) → $bucket_name/put_objects-SSE-KMS/$file_name"
    else
        aws s3api put-object --bucket "$bucket_name" --key "put_objects-SSE-KMS/$file_name" --body "$file_name" --server-side-encryption aws:kms
        echo "⚠️ Using AWS Managed CMK KMS Key (No KMS Key ID provided)"
    fi

    # SSE-C (Customer Provided Key)
    encryption_key=$(openssl rand -base64 32)  # Generate a 256-bit key
    encryption_key_bin=$(echo -n "$encryption_key" | base64 --decode)  # Convert to binary
    key_md5=$(echo -n "$encryption_key_bin" | openssl dgst -md5 -binary | base64)  # Compute MD5

    aws s3api put-object --bucket "$bucket_name" --key "put_objects-SSE-C/$file_name" --body "$file_name" \
        --sse-customer-algorithm AES256 --sse-customer-key "$encryption_key" --sse-customer-key-md5 "$key_md5"
    
    echo "✅ Uploaded with SSE-C (Customer Key) → $bucket_name/put_objects-SSE-C/$file_name"
    echo "🔑 Save this key for future retrieval: $encryption_key"

else
    echo "❌ Error: File '$file_name' not found!"
    exit 1
fi
